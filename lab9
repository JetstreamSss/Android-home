import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

/// ---------- Model ----------
class Product {
  final int id;
  final String name;
  final double price;
  final IconData icon;

  const Product(this.id, this.name, this.price, this.icon);
}

const List<Product> kProducts = [
  Product(1, 'Headphones', 59.99, Icons.headphones),
  Product(2, 'Smart Watch', 129.50, Icons.watch),
  Product(3, 'Keyboard', 45.00, Icons.keyboard),
  Product(4, 'Camera', 349.99, Icons.camera_alt),
  Product(5, 'Backpack', 39.90, Icons.backpack),
  Product(6, 'Speaker', 79.00, Icons.speaker),
];

/// ---------- State ----------
class CartProvider extends ChangeNotifier {
  final Map<int, Product> _items = {};

  List<Product> get items => _items.values.toList();
  int get count => _items.length;
  double get total => _items.values.fold(0.0, (sum, p) => sum + p.price);

  bool contains(Product p) => _items.containsKey(p.id);

  /// Add if missing, remove if present (used by the catalog toggle).
  void toggle(Product p) {
    if (_items.containsKey(p.id)) {
      _items.remove(p.id);
    } else {
      _items[p.id] = p;
    }
    notifyListeners();
  }

  void remove(Product p) {
    if (_items.remove(p.id) != null) notifyListeners();
  }

  void clear() {
    if (_items.isEmpty) return;
    _items.clear();
    notifyListeners();
  }
}

/// ---------- App ----------
void main() {
  runApp(
    ChangeNotifierProvider(
      create: (_) => CartProvider(),
      child: const MyApp(),
    ),
  );
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Global Cart Demo',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        useMaterial3: true,
        colorSchemeSeed: Colors.indigo,
      ),
      home: const CatalogScreen(),
    );
  }
}

/// ---------- Screen 1: Catalog ----------
class CatalogScreen extends StatelessWidget {
  const CatalogScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Catalog'),
        actions: [
          // Live badge: rebuilds whenever the cart changes, on ANY screen.
          Consumer<CartProvider>(
            builder: (context, cart, _) => Padding(
              padding: const EdgeInsets.only(right: 12),
              child: IconButton(
                tooltip: 'Open cart',
                icon: Badge(
                  isLabelVisible: cart.count > 0,
                  label: Text('${cart.count}'),
                  child: const Icon(Icons.shopping_cart_outlined),
                ),
                onPressed: () => Navigator.of(context).push(
                  MaterialPageRoute(builder: (_) => const CartScreen()),
                ),
              ),
            ),
          ),
        ],
      ),
      body: ListView.separated(
        padding: const EdgeInsets.all(12),
        itemCount: kProducts.length,
        separatorBuilder: (_, __) => const SizedBox(height: 8),
        itemBuilder: (context, i) => _ProductTile(product: kProducts[i]),
      ),
    );
  }
}

class _ProductTile extends StatelessWidget {
  final Product product;
  const _ProductTile({required this.product});

  @override
  Widget build(BuildContext context) {
    final inCart = context.select<CartProvider, bool>((c) => c.contains(product));

    return Card(
      child: ListTile(
        leading: CircleAvatar(child: Icon(product.icon)),
        title: Text(product.name),
        subtitle: Text('\$${product.price.toStringAsFixed(2)}'),
        trailing: inCart
            ? FilledButton.icon(
                onPressed: () => context.read<CartProvider>().toggle(product),
                icon: const Icon(Icons.check),
                label: const Text('Added'),
              )
            : OutlinedButton.icon(
                onPressed: () => context.read<CartProvider>().toggle(product),
                icon: const Icon(Icons.add_shopping_cart),
                label: const Text('Add'),
              ),
      ),
    );
  }
}

/// ---------- Screen 2: Cart ----------
class CartScreen extends StatelessWidget {
  const CartScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final cart = context.watch<CartProvider>();
    final items = cart.items;

    return Scaffold(
      appBar: AppBar(
        title: Text('Cart (${cart.count})'),
        actions: [
          TextButton.icon(
            onPressed: items.isEmpty ? null : () => cart.clear(),
            icon: const Icon(Icons.delete_sweep_outlined),
            label: const Text('Clear All'),
          ),
        ],
      ),
      body: items.isEmpty
          ? const Center(child: Text('Your cart is empty'))
          : ListView.builder(
              padding: const EdgeInsets.all(12),
              itemCount: items.length,
              itemBuilder: (context, i) {
                final p = items[i];
                return Card(
                  child: ListTile(
                    leading: CircleAvatar(child: Icon(p.icon)),
                    title: Text(p.name),
                    subtitle: Text('\$${p.price.toStringAsFixed(2)}'),
                    trailing: IconButton(
                      tooltip: 'Remove',
                      icon: const Icon(Icons.remove_circle_outline),
                      onPressed: () => cart.remove(p),
                    ),
                  ),
                );
              },
            ),
      bottomNavigationBar: SafeArea(
        child: Padding(
          padding: const EdgeInsets.all(16),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text('Total', style: Theme.of(context).textTheme.titleMedium),
              Text(
                '\$${cart.total.toStringAsFixed(2)}',
                style: Theme.of(context).textTheme.headlineSmall,
              ),
            ],
          ),
        ),
      ),
    );
  }
}
