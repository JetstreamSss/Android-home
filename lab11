import 'dart:convert';

import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';

/// Central place for storage keys (avoids typos).
class PrefKeys {
  static const darkMode = 'app_theme_dark_mode';
  static const userName = 'user_display_name';
  static const notes = 'notes_json_list';
}

/// Domain model with JSON (de)serialization.
class NoteItem {
  final String id;
  final String title;
  final String dateText;
  final bool isCompleted;

  const NoteItem({
    required this.id,
    required this.title,
    required this.dateText,
    this.isCompleted = false,
  });

  NoteItem copyWith({bool? isCompleted}) => NoteItem(
        id: id,
        title: title,
        dateText: dateText,
        isCompleted: isCompleted ?? this.isCompleted,
      );

  Map<String, dynamic> toJson() => {
        'id': id,
        'title': title,
        'dateText': dateText,
        'isCompleted': isCompleted,
      };

  factory NoteItem.fromJson(Map<String, dynamic> json) => NoteItem(
        id: json['id'] as String,
        title: json['title'] as String,
        dateText: json['dateText'] as String,
        isCompleted: json['isCompleted'] as bool? ?? false,
      );
}

/// 1. Pre-load storage BEFORE runApp() so the first frame already has the
///    correct theme (no white flash in dark mode).
Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final prefs = await SharedPreferences.getInstance();
  final isDark = prefs.getBool(PrefKeys.darkMode) ?? false;
  runApp(VaultApp(prefs: prefs, initialDark: isDark));
}

class VaultApp extends StatefulWidget {
  final SharedPreferences prefs;
  final bool initialDark;

  const VaultApp({super.key, required this.prefs, required this.initialDark});

  @override
  State<VaultApp> createState() => _VaultAppState();
}

class _VaultAppState extends State<VaultApp> {
  late bool _isDark = widget.initialDark;

  Future<void> _setDark(bool value) async {
    setState(() => _isDark = value);
    await widget.prefs.setBool(PrefKeys.darkMode, value);
  }

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Offline Notes Vault',
      debugShowCheckedModeBanner: false,
      themeMode: _isDark ? ThemeMode.dark : ThemeMode.light,
      theme: ThemeData(colorSchemeSeed: Colors.indigo, useMaterial3: true),
      darkTheme: ThemeData(
        colorSchemeSeed: Colors.indigo,
        brightness: Brightness.dark,
        useMaterial3: true,
      ),
      home: VaultPage(
        prefs: widget.prefs,
        isDark: _isDark,
        onDarkChanged: _setDark,
      ),
    );
  }
}

class VaultPage extends StatefulWidget {
  final SharedPreferences prefs;
  final bool isDark;
  final ValueChanged<bool> onDarkChanged;

  const VaultPage({
    super.key,
    required this.prefs,
    required this.isDark,
    required this.onDarkChanged,
  });

  @override
  State<VaultPage> createState() => _VaultPageState();
}

class _VaultPageState extends State<VaultPage> {
  final _nameController = TextEditingController();
  final _noteController = TextEditingController();

  late String _displayName;
  late List<NoteItem> _notes;

  @override
  void initState() {
    super.initState();
    // 2. Load username with null-safe fallback.
    _displayName = widget.prefs.getString(PrefKeys.userName) ?? 'Guest User';
    _nameController.text =
        _displayName == 'Guest User' ? '' : _displayName;
    // 3. Deserialize notes from JSON.
    _notes = _loadNotes();
  }

  @override
  void dispose() {
    _nameController.dispose();
    _noteController.dispose();
    super.dispose();
  }

  // ---------- Persistence helpers ----------

  List<NoteItem> _loadNotes() {
    final raw = widget.prefs.getString(PrefKeys.notes);
    if (raw == null || raw.isEmpty) return [];
    try {
      final decoded = jsonDecode(raw) as List<dynamic>;
      return decoded
          .map((e) => NoteItem.fromJson(e as Map<String, dynamic>))
          .toList();
    } catch (_) {
      return []; // corrupted data -> start clean instead of crashing
    }
  }

  Future<void> _saveNotes() async {
    final jsonString = jsonEncode(_notes.map((n) => n.toJson()).toList());
    await widget.prefs.setString(PrefKeys.notes, jsonString);
  }

  Future<void> _saveName() async {
    final name = _nameController.text.trim();
    if (name.isEmpty) return;
    await widget.prefs.setString(PrefKeys.userName, name);
    setState(() => _displayName = name);
    FocusScope.of(context).unfocus();
    _snack('Username saved');
  }

  // ---------- Notes CRUD ----------

  String _formatNow() {
    final d = DateTime.now();
    String two(int v) => v.toString().padLeft(2, '0');
    return '${two(d.day)}.${two(d.month)}.${d.year} ${two(d.hour)}:${two(d.minute)}';
  }

  Future<void> _addNote() async {
    final title = _noteController.text.trim();
    if (title.isEmpty) return;
    final note = NoteItem(
      id: DateTime.now().microsecondsSinceEpoch.toString(),
      title: title,
      dateText: _formatNow(),
    );
    setState(() => _notes.insert(0, note)); // prepend
    _noteController.clear();
    await _saveNotes();
  }

  Future<void> _toggleNote(String id) async {
    setState(() {
      final i = _notes.indexWhere((n) => n.id == id);
      if (i != -1) {
        _notes[i] = _notes[i].copyWith(isCompleted: !_notes[i].isCompleted);
      }
    });
    await _saveNotes();
  }

  Future<void> _deleteNote(String id) async {
    setState(() => _notes.removeWhere((n) => n.id == id));
    await _saveNotes();
  }

  void _snack(String msg) {
    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(SnackBar(content: Text(msg)));
  }

  // ---------- UI ----------

  @override
  Widget build(BuildContext context) {
    final scheme = Theme.of(context).colorScheme;

    return Scaffold(
      appBar: AppBar(
        title: Text('Hello, $_displayName'),
        actions: [
          Icon(widget.isDark ? Icons.dark_mode : Icons.light_mode),
          Switch(value: widget.isDark, onChanged: widget.onDarkChanged),
        ],
      ),
      body: SafeArea(
        child: Column(
          children: [
            Padding(
              padding: const EdgeInsets.fromLTRB(16, 12, 16, 0),
              child: Row(
                children: [
                  Expanded(
                    child: TextField(
                      controller: _nameController,
                      textInputAction: TextInputAction.done,
                      onSubmitted: (_) => _saveName(),
                      decoration: const InputDecoration(
                        labelText: 'Username',
                        prefixIcon: Icon(Icons.person),
                        border: OutlineInputBorder(),
                      ),
                    ),
                  ),
                  const SizedBox(width: 8),
                  FilledButton(onPressed: _saveName, child: const Text('Save')),
                ],
              ),
            ),
            Padding(
              padding: const EdgeInsets.all(16),
              child: Row(
                children: [
                  Expanded(
                    child: TextField(
                      controller: _noteController,
                      textInputAction: TextInputAction.done,
                      onSubmitted: (_) => _addNote(),
                      decoration: const InputDecoration(
                        labelText: 'New note',
                        prefixIcon: Icon(Icons.note_add),
                        border: OutlineInputBorder(),
                      ),
                    ),
                  ),
                  const SizedBox(width: 8),
                  FilledButton.tonalIcon(
                    onPressed: _addNote,
                    icon: const Icon(Icons.add),
                    label: const Text('Add'),
                  ),
                ],
              ),
            ),
            Expanded(
              child: _notes.isEmpty
                  ? Center(
                      child: Text(
                        'No notes yet. Add your first one!',
                        style: TextStyle(color: scheme.outline),
                      ),
                    )
                  : ListView.builder(
                      itemCount: _notes.length,
                      itemBuilder: (context, index) {
                        final note = _notes[index];
                        return Card(
                          margin: const EdgeInsets.symmetric(
                              horizontal: 16, vertical: 4),
                          child: ListTile(
                            leading: Checkbox(
                              value: note.isCompleted,
                              onChanged: (_) => _toggleNote(note.id),
                            ),
                            title: Text(
                              note.title,
                              style: TextStyle(
                                decoration: note.isCompleted
                                    ? TextDecoration.lineThrough
                                    : null,
                              ),
                            ),
                            subtitle: Text(note.dateText),
                            trailing: IconButton(
                              icon: const Icon(Icons.delete_outline),
                              onPressed: () => _deleteNote(note.id),
                            ),
                          ),
                        );
                      },
                    ),
            ),
          ],
        ),
      ),
    );
  }
}
